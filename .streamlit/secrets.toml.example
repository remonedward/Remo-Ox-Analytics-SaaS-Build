# ================================================================
# REMO_OX Analytics — Streamlit Secrets Template
# Copy this to .streamlit/secrets.toml and fill in real values.
# NEVER commit secrets.toml to git.
# ================================================================

# ---- LLM Provider (admin-only; users never see this) -----------
# Default recommended provider: Google Gemini (modern, high capability, ultra-low cost)
# Format: "<provider>/<model>" — any LiteLLM-compatible string.
# Examples:
#   gemini/gemini-2.0-flash            (Google Gemini - recommended default)
#   gemini/gemini-1.5-flash            (Google Gemini)
#   openai/gpt-4o-mini                 (OpenAI)
#   anthropic/claude-3-5-haiku-20241022 (Anthropic)
#   groq/llama-3.3-70b-versatile       (Groq)
#   deepseek/deepseek-chat             (DeepSeek)
#   ollama/llama3.2                    (set LLM_API_BASE to your Ollama URL)
#   azure/gpt-4o                       (set LLM_API_BASE to your Azure endpoint)
LLM_MODEL = "gemini/gemini-2.0-flash"
LLM_API_KEY = "your-api-key-here"
LLM_API_BASE = ""            # Leave empty for Gemini/OpenAI/Anthropic/Groq direct
LLM_TEMPERATURE = 0.2
LLM_MAX_TOKENS = 1500
LLM_FALLBACK_MODEL = ""      # Optional, e.g. "gemini/gemini-1.5-flash" or "groq/llama-3.1-8b-instant"
LLM_FALLBACK_API_KEY = ""    # Key for fallback model if different provider

# ---- Admin & Plans ---------------------------------------------
ADMIN_EMAILS = "you@yourdomain.com"   # Comma-separated
DEFAULT_PLAN = "trial"

# ---- Upload & Retention ----------------------------------------
MAX_UPLOAD_MB = 10
MAX_ROWS = 200000
MAX_COLUMNS = 200
RETENTION_DAYS = 90

# ---- Privacy ---------------------------------------------------
# Set to true ONLY if you accept the privacy implications of sending
# raw sample rows to the LLM provider. Default: false.
SEND_SAMPLE_ROWS_TO_LLM = false

# ---- Supabase --------------------------------------------------
# Leave blank to run in local dev mode (SQLite + local filesystem).
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_ANON_KEY = "eyJ..."
SUPABASE_SERVICE_KEY = "eyJ..."

# ---- Branding --------------------------------------------------
APP_NAME = "REMO_OX Analytics"
BRAND_PRIMARY_COLOR = "#1B4F72"
DEFAULT_LANGUAGE = "ar"     # "ar" or "en"
