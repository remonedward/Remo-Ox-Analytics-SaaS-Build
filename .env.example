# LLM Provider settings (admin-only, never expose to users)
# Default recommended provider: Google Gemini (modern, blazing-fast, low-cost)
# Any LiteLLM provider string is supported:
#   gemini/gemini-2.0-flash (Google - modern & ultra low cost)
#   gemini/gemini-1.5-flash (Google - lightweight)
#   openai/gpt-4o-mini      (OpenAI)
#   anthropic/claude-3-5-haiku-20241022 (Anthropic)
#   groq/llama-3.3-70b-versatile        (Groq)
#   deepseek/deepseek-chat              (DeepSeek)
#   ollama/llama3.2                     (Local via Ollama)
LLM_MODEL=gemini/gemini-2.0-flash
LLM_API_KEY=your-gemini-or-provider-api-key-here
LLM_API_BASE=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# Admin
ADMIN_EMAILS=you@example.com,admin2@example.com
DEFAULT_PLAN=trial

# Upload limits
MAX_UPLOAD_MB=10
MAX_ROWS=200000
MAX_COLUMNS=200
RETENTION_DAYS=90

# Privacy
SEND_SAMPLE_ROWS_TO_LLM=false

# Supabase (leave blank for local dev mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# App branding
APP_NAME=REMO_OX Analytics
BRAND_PRIMARY_COLOR=#1B4F72
DEFAULT_LANGUAGE=ar
